# Copy to .env (git-ignored) and fill in only what you need.
# Every setting is optional: Terminus runs fully offline in demo mode.

# live | demo  (demo serves recorded API responses from data/fixtures)
TERMINUS_MODE=live
# TERMINUS_DB_PATH=./terminus.db

# Bearer token required by every /api route of the FastAPI backend.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TERMINUS_API_TOKEN=

# NVD API key (free): https://nvd.nist.gov/developers/request-an-api-key
# Without it NVD allows ~5 requests / 30 s, so full scans are slow.
TERMINUS_NVD_API_KEY=

# Optional web research: none | tavily | exa
TERMINUS_SEARCH_PROVIDER=none
TERMINUS_TAVILY_API_KEY=
TERMINUS_EXA_API_KEY=

# Optional LLM research layer (LlamaIndex): none | openai | anthropic
# Requires: uv sync --extra agent-openai   (or --extra agent-anthropic)
TERMINUS_LLM_PROVIDER=none
TERMINUS_LLM_MODEL=
TERMINUS_OPENAI_API_KEY=
TERMINUS_ANTHROPIC_API_KEY=

# Research budgets per CVE investigation
TERMINUS_AGENT_MAX_TOOL_CALLS=12
TERMINUS_AGENT_MAX_SEARCH_CALLS=2
TERMINUS_AGENT_MAX_SECONDS=60

# Optional JSON file overriding risk weights/thresholds (see README)
# TERMINUS_RISK_CONFIG=./risk.json
