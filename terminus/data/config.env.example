# Terminus configuration file.
#
# `terminus init` copies this template to config.env in your Terminus home
# (see `terminus info`). Every setting is optional: demo scans and the core
# deterministic workflow need no keys at all. Real environment variables take
# precedence over values in this file.
#
# Keep this file private: it may contain API keys.

# live | demo  (demo serves recorded API responses bundled with Terminus;
# `terminus scan --demo` selects demo data for a single scan)
TERMINUS_MODE=live

# Database location (default: terminus.db next to this file)
# TERMINUS_DB_PATH=

# NVD API key (free): https://nvd.nist.gov/developers/request-an-api-key
# Without it NVD allows ~5 requests / 30 s, so live scans are slower.
TERMINUS_NVD_API_KEY=

# Optional web research: none | tavily | exa
TERMINUS_SEARCH_PROVIDER=none
TERMINUS_TAVILY_API_KEY=
TERMINUS_EXA_API_KEY=

# Optional LLM research layer (LlamaIndex): none | openai | anthropic
# Needs the matching extra, e.g.
#   uv tool install --force "terminus[agent-openai] @ git+https://github.com/Asmit12357/terminus.git"
TERMINUS_LLM_PROVIDER=none
TERMINUS_LLM_MODEL=
TERMINUS_OPENAI_API_KEY=
TERMINUS_ANTHROPIC_API_KEY=

# Research budgets per CVE investigation
TERMINUS_AGENT_MAX_TOOL_CALLS=12
TERMINUS_AGENT_MAX_SEARCH_CALLS=2
TERMINUS_AGENT_MAX_SECONDS=60

# Optional JSON file overriding risk weights/thresholds (see README)
# TERMINUS_RISK_CONFIG=

# Bearer token for the optional REST API (`terminus serve-api`, needs the
# "api" extra). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TERMINUS_API_TOKEN=
